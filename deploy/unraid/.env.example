# Image references are replaced with immutable digests after every successful CI build.
SPARKY_FITNESS_FRONTEND_IMAGE=ghcr.io/hbui3/sparkyfitness-frontend:main
SPARKY_FITNESS_SERVER_IMAGE=ghcr.io/hbui3/sparkyfitness-server:main
SPARKY_FITNESS_SOURCE_SHA=bootstrap

# Persistent Unraid storage. Keep this on the appdata share.
UNRAID_APPDATA_ROOT=/mnt/user/appdata/sparkyfitness

# Database credentials. bootstrap.sh replaces all CHANGE_ME values.
SPARKY_FITNESS_DB_NAME=sparkyfitness_db
SPARKY_FITNESS_DB_USER=sparky
SPARKY_FITNESS_DB_PASSWORD=CHANGE_ME
SPARKY_FITNESS_APP_DB_USER=sparky_app
SPARKY_FITNESS_APP_DB_PASSWORD=CHANGE_ME

# Public or Tailnet URL used by the browser and iOS app.
SPARKY_FITNESS_FRONTEND_URL=CHANGE_ME
SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS=
SPARKY_FITNESS_BIND_ADDRESS=0.0.0.0
SPARKY_FITNESS_FRONTEND_PORT=3004

# Stable application secrets. Never rotate these casually on an existing install.
SPARKY_FITNESS_API_ENCRYPTION_KEY=CHANGE_ME
BETTER_AUTH_SECRET=CHANGE_ME

# Telegram coach. Create the token with BotFather. bootstrap.sh generates the
# webhook secret; the URL defaults to FRONTEND_URL/api/telegram/webhook.
SPARKY_FITNESS_TELEGRAM_BOT_TOKEN=
SPARKY_FITNESS_TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
SPARKY_FITNESS_TELEGRAM_WEBHOOK_URL=

# Account setup. After creating the first account, set DISABLE_SIGNUP=true.
SPARKY_FITNESS_DISABLE_SIGNUP=false
SPARKY_FITNESS_ADMIN_EMAIL=
SPARKY_FITNESS_FORCE_EMAIL_LOGIN=true

# Secure defaults.
SPARKY_FITNESS_LOG_LEVEL=ERROR
SPARKY_FITNESS_PUBLIC_API_DOCS=false
ALLOW_PRIVATE_NETWORK_CORS=false
ALLOW_PRIVATE_NETWORK_AI=false
DEV_TOOLS_ENABLED=false
NGINX_RATE_LIMIT=5r/s
NGINX_LISTEN_PORT=80
TZ=Europe/Berlin

# Optional email delivery.
SPARKY_FITNESS_EMAIL_HOST=
SPARKY_FITNESS_EMAIL_PORT=
SPARKY_FITNESS_EMAIL_SECURE=
SPARKY_FITNESS_EMAIL_USER=
SPARKY_FITNESS_EMAIL_PASS=
SPARKY_FITNESS_EMAIL_FROM=

# Optional integration/proxy settings.
GARMIN_MICROSERVICE_URL=
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
